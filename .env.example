# praxis-ai environment
#
# Copy to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored. Nothing in this file is required to develop,
# build, or test praxis-ai: `npm ci && npm test` works with it absent.
# Every entry is either a local override or a publishing credential.

# ---------------------------------------------------------------------------
# Local overrides (no secrets)
# ---------------------------------------------------------------------------

# Home directory praxis operates on. Overrides the OS home for `~/.claude`
# and `~/.praxis` resolution.
#
# This is the one that matters day to day: point it at a scratch directory
# and `praxis install` / `praxis uninstall` exercise the real code paths
# without touching your actual configuration. Every install test in this
# repo works this way.
#
#   PRAXIS_HOME=/tmp/praxis-sandbox
PRAXIS_HOME=

# Base directory for OpenCode's config ($XDG_CONFIG_HOME/opencode).
# Ignored when PRAXIS_HOME is set.
XDG_CONFIG_HOME=

# Any non-empty value stops the AST hook writing deny_hit rows to the
# local SQLite telemetry database.
PRAXIS_TELEMETRY_DISABLED=

# Path to the AST hook binary used by `npm run bench:hook`.
# Defaults to ./bin/praxis-ast-hook.js.
PRAXIS_AST_HOOK_BIN=

# ---------------------------------------------------------------------------
# Publishing credentials (secrets - never commit a filled-in .env)
# ---------------------------------------------------------------------------

# npm token with publish rights on the `praxis-ai` package.
#
# The normal release path does NOT need this locally. Publishing runs in
# GitHub Actions from the repository secret of the same name, triggered by
# publishing a GitHub Release. Set it here only to publish by hand.
#
# Where to get one: npmjs.com -> avatar -> Access Tokens -> Generate New
# Token -> Granular Access Token, with Read and write on the `praxis-ai`
# package. Classic "Automation" tokens also work and do not expire.
NPM_TOKEN=

# GitHub token for `gh` operations (releases, PRs) when the `gh` CLI is not
# already logged in. `gh auth login` is the better path; this is the
# non-interactive fallback.
GITHUB_TOKEN=
